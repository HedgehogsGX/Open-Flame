VDC_HOST=127.0.0.1
VDC_PORT=8000
VDC_DATA_ROOT=./data
VDC_DATABASE_PATH=./data/control.sqlite3
VDC_MAX_BATCH_URLS=50
VDC_ROUTE_POLICY_VERSION=mvp-v1
VDC_STORAGE_MIN_FREE_BYTES=1073741824
# Structured, redacted JSONL troubleshooting logs are written below
# VDC_DATA_ROOT/logs. These values control level and per-component rotation.
VDC_RUNTIME_LOG_LEVEL=INFO
VDC_RUNTIME_LOG_MAX_BYTES=10485760
VDC_RUNTIME_LOG_BACKUP_COUNT=5
# Optional fixed Windows tool bundle. This setting deliberately requires an
# absolute normalized path and does not enable a networked Worker by itself.
# VDC_TOOL_ROOT=C:\\absolute\\path\\to\\runtime-tools\\windows-x64
# Windows local direct Worker stays off unless this exact gate and the separate
# --allow-direct-network CLI acknowledgement are both present.
VDC_ENABLE_LOCAL_REAL_WORKER=0
# Offline graph-v2 orchestration candidate only. Keep disabled for real adapters
# until an authorized Stage 0 proves stable X attachment keys and exact selection.
VDC_ENABLE_X_GRAPH_V2=0
# Short-link expansion stays fail-closed unless a separately supervised,
# attested egress UDS and private shared-key file are explicitly configured.
VDC_ENABLE_SHORT_LINK_RESOLUTION=0
# POSIX only; both processes must share one effective UID and private key.
# VDC_SHORT_LINK_TRANSPORT_SOCKET=/run/vdc-short-link/egress.sock
# VDC_SHORT_LINK_ATTESTATION_KEY_FILE=/etc/vdc-short-link.key
